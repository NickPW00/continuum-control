# Copie para .env (fora do repositório) e troque as senhas. Sem .env, o compose usa os valores
# padrão de desenvolvimento.

# Perfil: dev carrega os dados iniciais (§25)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL: administrador do contêiner, dono do esquema (Flyway) e usuário da aplicação (D43)
POSTGRES_ADMIN_USER=continuum
POSTGRES_ADMIN_PASSWORD=troque-esta-senha
DB_URL=jdbc:postgresql://localhost:5434/continuum
DB_MIGRACAO_USER=continuum_migracao
DB_MIGRACAO_PASSWORD=troque-esta-senha
DB_APP_USER=continuum_app
DB_APP_PASSWORD=troque-esta-senha

# MongoDB: administrador do contêiner e usuário da aplicação
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_APP_USER=continuum_app
MONGO_APP_PASSWORD=troque-esta-senha
MONGO_URI=mongodb://continuum_app:troque-esta-senha@localhost:27017/continuum?authSource=continuum&serverSelectionTimeoutMS=2000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=troque-esta-senha

# Segredo de assinatura dos tokens: 32 bytes aleatórios ou mais (doc 06)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-bytes

SERVER_PORT=8080
